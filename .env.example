# Ledgerline environment — copy to .env.local (never commit real values)
# Aurora DSQL (single-region)
DSQL_ENDPOINT=ijt4jtjkn7oxftooklnuliggna.dsql.us-east-1.on.aws
DSQL_DATABASE=postgres
DSQL_USER=admin
AWS_REGION=us-east-1

# AWS credentials (use a scoped IAM user/role, not root)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ingest pipeline
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/904907793501/ledgerline-usage-events

# Optional threshold alerts
SNS_TOPIC_ARN=
